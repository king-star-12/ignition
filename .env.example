# ---------------------------------------------------------------
# LaunchPilot configuration
# Copy to .env.local and fill in. Never commit real credentials.
# Never prefix a secret with NEXT_PUBLIC_ — that ships it to the browser.
# ---------------------------------------------------------------

# Which LLM provider to use first: groq | openrouter
# If the preferred provider has no key, LaunchPilot falls back to the other.
AI_PROVIDER=groq

# https://console.groq.com/keys
# Check https://console.groq.com/docs/models for the current list —
# Groq retires models regularly (the Llama 3.x ids are already gone).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# --- Web research ---------------------------------------------------
# LaunchPilot tries providers in order and falls back automatically:
#   SerpApi (best results, 250 searches/month free)
#   -> Brave (2,000/month free)
#   -> Hacker News via Algolia (no key, no quota, technical skew)
# Results are cached on disk for 7 days, so repeat runs cost nothing.
# Set SEARCH_PROVIDER to pin one: serpapi | brave | hackernews

# https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# https://brave.com/search/api/
BRAVE_API_KEY=

SEARCH_PROVIDER=

# https://www.name.com/account/settings/api
NAMECOM_API_KEY=
NAMECOM_USERNAME=
# Use https://api.dev.name.com for name.com's test environment.
NAMECOM_BASE_URL=https://api.name.com

# true  -> every stage uses deterministic, clearly labelled sample data
# false -> real SerpApi, real name.com, real LLM (each falls back to
#          labelled sample data if its key is missing or the call fails)
DEMO_MODE=false
